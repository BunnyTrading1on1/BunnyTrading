# Resend API key — create one free at https://resend.com/api-keys
RESEND_API_KEY=

# The inbox that contact form submissions get emailed to
CONTACT_EMAIL=your@email.com

# Optional: sender address. The default (Resend's shared onboarding
# address) only delivers to the email you verified on your Resend
# account, which is fine for personal use. Verify your own domain in
# Resend to send from e.g. "Bunny Trading <dm@bunnytrading.com>".
CONTACT_FROM=Bunny Trading <onboarding@resend.dev>

# Optional: Google Search Console site verification.
# Search Console (search.google.com/search-console) > Add property >
# HTML tag method gives you a string like "abc123..." — paste just
# that value here, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement ID (starts with "G-").
# Create a GA4 property at analytics.google.com > Admin > Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Student portal (Education Hub) — powers real per-student login and data.
# Create a free project at supabase.com, then Project Settings > API for these two:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
